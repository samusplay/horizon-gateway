{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ruta-prueba": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "events-route": {
        "ClusterId": "events-cluster",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },
      "flow-route": {
        "ClusterId": "flow-cluster",
        "Match": {
          "Path": "/ws/{**catch-all}"
        }
      },
      "channels-route": {
        "ClusterId": "channels-cluster",
        "Match": {
          "Path": "/api/channels/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destino-principal": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "events-cluster": {
        "Destinations": {
          "destino-principal": {
            "Address": "http://localhost:5006"
          }
        }
      },
      "flow-cluster": {
        "Destinations": {
          "destino-principal": {
            "Address": "http://localhost:5007"
          }
        }
      },
      "channels-cluster": {
        "Destinations": {
          "destino-principal": {
            "Address": "http://localhost:5009"
          }
        }
      }
    }
  }
}